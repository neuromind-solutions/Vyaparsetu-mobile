# VyapaarSetu Backend — Environment Configuration Example
# Copy this file to '.env' and fill in your values.

PORT=5000
NODE_ENV=development

# DB_PATH is optional and normally left UNSET. database/db.js anchors the database
# to backend/database/vyapaarsetu.db no matter where the server is launched from.
# Only set it to an ABSOLUTE path to relocate the data (e.g. onto another drive);
# a relative value resolves against the launch directory and splits the data across
# two files. The test harness sets it per-run to a temp file.

# LICENSE_PATH is optional and normally left UNSET. licenseService.js defaults to
# backend/database/license.json; the packaged app points it at
# %APPDATA%/VyapaarSetu/license.json. It deliberately sits OUTSIDE the SQLite file so
# a backup/restore (which swaps the whole .db) can neither wipe the activation nor
# import another machine's license.

# LICENSE_DEV_BYPASS skips activation so `npm run dev` needs no license key.
# DEV ONLY — ignored whenever NODE_ENV=production, so it can never unlock a shipped
# app. Leave unset unless you are actively developing.
# LICENSE_DEV_BYPASS=1

# Google Drive API OAuth 2.0 Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/drive/oauth-callback
